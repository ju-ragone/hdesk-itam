# ==============================================================================
# CONFIGURACIÓN DE ENTORNO (PLANTILLA DE EJEMPLO)
# Copiar este archivo a .env antes del despliegue: cp .env.example .env
# ==============================================================================

# --- Configuración General Snipe-IT ---
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es-ES
# Generar una clave propia con: docker run --rm snipe/snipe-it:latest php artisan key:generate --show
APP_KEY=base64:YOUR_APP_KEY_HERE_GENERATE_WITH_ARTISAN=

# --- Base de Datos Snipe-IT ---
DB_CONNECTION=mysql
DB_HOST=snipe-mysql
DB_PORT=3306
DB_DATABASE=snipeit
DB_USERNAME=snipeit_user
DB_PASSWORD=ChangeMe_SnipeUser_Password!
MYSQL_ROOT_PASSWORD=ChangeMe_SnipeRoot_Password!

# --- Mail Snipe-IT ---
MAIL_MAILER=log
MAIL_PORT=2525

# --- GLPI Database Credentials ---
GLPI_DB_ROOT_PASSWORD=ChangeMe_GlpiRoot_Password!
GLPI_DB_NAME=glpidb
GLPI_DB_USER=glpi_user
GLPI_DB_PASSWORD=ChangeMe_GlpiUser_Password!

# --- Docker Compose Project ---
COMPOSE_PROJECT_NAME=snipe-it
